{
  "appId": "com.nanobot.desktop",
  "productName": "Nanobot Desktop",
  "copyright": "Copyright © 2026 Nanobot AI",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "electron/entitlements.mac.plist",
    "entitlementsInherit": "electron/entitlements.mac.plist",
    "darkModeSupport": true
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "images/nanobot_logo.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Nanobot Desktop"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Development;Utility;",
    "synopsis": "Lightweight Personal AI Agent Desktop Environment & MCP Gateway"
  }
}
