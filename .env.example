# nanobot environment variables — copy to `.env` (gitignored) and fill in, or
# export them from your shell / process manager. Never commit real secrets.

# Google Antigravity (agy mock) OAuth client. Required to enable this provider;
# the values are not shipped in source and have no default.
# Equivalent config keys: providers.googleAntigravity.antigravity.clientId / clientSecret
NANOBOT_ANTIGRAVITY_CLIENT_ID=your-google-oauth-client-id
NANOBOT_ANTIGRAVITY_CLIENT_SECRET=your-google-oauth-client-secret
